# Optional settings for live tests; the only allowed model endpoint is the private LAN service.
# Prefer: uv run --extra dev pytest --run-private-e2e -m e2e -q
# Copy to .env and export only when pinning a model or supplying a local credential.
# An empty model discovers /models; multiple advertised models require an explicit ID.
AGENTBOARD_E2E_CODEX_BASE_URL=http://192.168.1.220:30000/v1
AGENTBOARD_E2E_CODEX_MODEL=

# Optional bearer credential. Leave empty for endpoints that do not require authentication.
AGENTBOARD_E2E_CODEX_API_KEY=

AGENTBOARD_E2E_CLASSIFICATION_BASE_URL=http://192.168.1.220:30000/v1
AGENTBOARD_E2E_CLASSIFICATION_MODEL=
AGENTBOARD_E2E_CLASSIFICATION_API_KEY=

# Optional, separate experiment archive. CLI > ~/.agentboard/config.toml > environment.
# AGENTBOARD_DATA_HOME=/absolute/path/outside/git/checkouts
# AGENTBOARD_EXPERIMENT_MODE=filesystem
# MLflow publication is not implemented; filesystem mode ignores MLFLOW_TRACKING_URI.

# Opt-in Codex Responses endpoint test.
# Copy this file to .env, replace the placeholders, and export it before running pytest.
AGENTBOARD_E2E_CODEX_BASE_URL=http://127.0.0.1:8000/v1
AGENTBOARD_E2E_CODEX_MODEL=test-model

# Optional bearer credential. Leave empty for endpoints that do not require authentication.
AGENTBOARD_E2E_CODEX_API_KEY=
